---
import { site, waUrl } from '../data/site';
---
<section class="section pt-14 pb-14 md:pt-[88px] md:pb-20">
  <div class="container-page grid gap-10 items-center" style="grid-template-columns: 1fr;">
    <div class="reveal">
      <div class="eyebrow inline-flex items-center gap-2 mb-2">
        <span class="hero-dot"></span>
        Consultoría híbrida · operación + datos
      </div>
      <div class="concept-line mb-[22px]">{site.brand.conceptLine}</div>
      <h1 class="display">{site.brand.tagline}</h1>
      <p class="lead">
        Trabajamos con PyMEs y negocios que ya facturan y necesitan ordenar cómo operan, ver sus datos y usar herramientas digitales que sí se usan. Sin teoría: hacemos que las cosas funcionen.
      </p>
      <div class="flex flex-wrap gap-3 items-center mt-7">
        <a class="btn btn-primary" href={waUrl('Hola, quiero agendar la auditoría gratuita de 30 minutos.')} target="_blank" rel="noopener">
          Auditoría gratuita · 30 min
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
      </div>
      <div class="flex flex-wrap gap-[18px] mt-[22px] text-ink-2 text-[13.5px]">
        <span class="inline-flex items-center gap-2"><i class="check">✓</i> Sin compromiso</span>
        <span class="inline-flex items-center gap-2"><i class="check">✓</i> Respuesta el mismo día hábil</span>
      </div>
    </div>

    <div class="reveal viz-wrap relative" aria-hidden="true">
      <span class="viz-chip tl">proceso · datos · decisión</span>
      <div class="viz-card">
        <div class="viz-head">
          <span class="viz-title">tablero · venta semanal</span>
          <span class="viz-dot" title="conectado"></span>
        </div>
        <div class="kpis">
          <div class="kpi"><div class="kpi-label">Ingresos</div><div class="kpi-value">$184k</div><div class="kpi-delta">▲ 12.4%</div></div>
          <div class="kpi"><div class="kpi-label">Órdenes</div><div class="kpi-value">312</div><div class="kpi-delta">▲ 6.1%</div></div>
          <div class="kpi"><div class="kpi-label">Devol.</div><div class="kpi-value">2.1%</div><div class="kpi-delta down">▼ 0.4%</div></div>
        </div>
        <div class="viz-chart">
          <svg viewBox="0 0 380 110" preserveAspectRatio="none" style="width:100%; height:100%;">
            <defs>
              <linearGradient id="g1" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#0F2A44" stop-opacity="0.18" />
                <stop offset="100%" stop-color="#0F2A44" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g stroke="#E4E1D7" stroke-width="1">
              <line x1="0" y1="20" x2="380" y2="20" />
              <line x1="0" y1="55" x2="380" y2="55" />
              <line x1="0" y1="90" x2="380" y2="90" />
            </g>
            <path d="M0 78 L40 70 L80 74 L120 60 L160 64 L200 48 L240 52 L280 36 L320 40 L360 24 L380 28 L380 110 L0 110 Z" fill="url(#g1)" />
            <path d="M0 78 L40 70 L80 74 L120 60 L160 64 L200 48 L240 52 L280 36 L320 40 L360 24 L380 28" fill="none" stroke="#0F2A44" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
            <circle cx="360" cy="24" r="4" fill="#C45B2D" stroke="#0F2A44" stroke-width="1.5" />
          </svg>
        </div>
        <div class="viz-foot">
          <span>lun</span><span>mar</span><span>mié</span><span>jue</span><span>vie</span><span>sáb</span><span>dom</span>
        </div>
      </div>
      <span class="viz-chip br">↑ tu negocio, visible</span>
    </div>
  </div>
</section>

<style>
  @media (min-width: 980px) {
    section .container-page { grid-template-columns: 1.18fr 1fr !important; gap: 64px !important; }
  }
  .hero-dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--terracota);
    box-shadow: 0 0 0 4px rgba(196,91,45,0.20);
  }
  .concept-line {
    font-family: var(--mono, "JetBrains Mono");
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracota);
    padding-left: 15px;
    border-left: 2px solid var(--terracota);
  }
  .check {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--navy); color: var(--paper);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700; font-style: normal;
  }
  .viz-card {
    background: var(--paper); border: 1px solid var(--line); border-radius: 12px;
    padding: 18px; box-shadow: 0 2px 4px rgba(15,42,68,0.05), 0 8px 24px rgba(15,42,68,0.06);
    position: relative;
  }
  .viz-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px dashed var(--line-2); margin-bottom: 14px; }
  .viz-title { font-family: var(--mono, "JetBrains Mono"); font-size: 12px; color: var(--ink-2); letter-spacing: 0.04em; }
  .viz-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px rgba(46,125,91,0.15); }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
  .kpi { border: 1px solid var(--line); border-radius: 4px; padding: 10px 12px; background: var(--paper-2); }
  .kpi-label { font-family: var(--mono, "JetBrains Mono"); font-size: 10px; color: var(--ink-3); letter-spacing: 0.08em; text-transform: uppercase; }
  .kpi-value { font-size: 19px; font-weight: 700; color: var(--navy); margin-top: 2px; letter-spacing: -0.02em; }
  .kpi-delta { font-family: var(--mono, "JetBrains Mono"); font-size: 10px; color: var(--ok); margin-top: 2px; }
  .kpi-delta.down { color: #B0480E; }
  .viz-chart { height: 110px; }
  .viz-foot { display: flex; justify-content: space-between; padding-top: 12px; margin-top: 12px; border-top: 1px dashed var(--line-2); font-family: var(--mono, "JetBrains Mono"); font-size: 10.5px; color: var(--ink-3); letter-spacing: 0.04em; }
  .viz-chip {
    position: absolute; background: var(--navy); color: var(--paper);
    font-family: var(--mono, "JetBrains Mono"); font-size: 10.5px;
    padding: 6px 10px; border-radius: 4px;
    box-shadow: 0 1px 0 rgba(15,42,68,0.04), 0 1px 2px rgba(15,42,68,0.04);
    letter-spacing: 0.04em; white-space: nowrap; z-index: 2;
  }
  .viz-chip.tl { top: -10px; left: -8px; }
  .viz-chip.br { bottom: -10px; right: -8px; background: var(--terracota); color: var(--paper); }
  @media (max-width: 760px) { .viz-chip.tl, .viz-chip.br { display: none; } }
</style>
