---
import { site } from '../data/site';

const icons: Record<string, string> = {
  wa:      '<path d="M20 12a8 8 0 1 1-3.05-6.3L20 4l-1 4.2A8 8 0 0 1 20 12Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 10.5a4.6 4.6 0 0 0 4 4l1.3-1.3-2.1-1-.9.4a2.6 2.6 0 0 1-1.4-1.4l.4-.9-1-2.1L8.5 10.5Z" fill="currentColor"/>',
  inv:     '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  pdf:     '<path d="M7 3h7l5 5v13H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5M10 13h6M10 16h6M10 19h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  report:  '<rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 8l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  quotes:  '<rect x="4" y="3" width="16" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 8h8M8 12h5M8 16h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="17" cy="17" r="2" fill="currentColor"/>',
  classif: '<circle cx="6" cy="6" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="6" cy="18" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 6h4M8.5 18h4M14 8l3 3M14 16l3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
};
---
<section id="automatizacion" class="section" style="background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">IA + automatización</span>
      <h2 class="h-section">Lo que sí automatizamos</h2>
      <p class="lead">Sin promesas mágicas. Cosas concretas que ya funcionan y que tu negocio puede tener corriendo esta semana, sin cambiar todo lo que ya tienes.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-[18px]">
      {site.automations.map((a) => (
        <article class="card-base p-[22px] flex flex-col gap-[10px] reveal">
          <div class="auto-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" set:html={icons[a.id]}></svg>
          </div>
          <h3 class="h-card text-[16.5px] leading-[1.3]">{a.title}</h3>
          <p class="small text-[14px]">{a.desc}</p>
        </article>
      ))}
    </div>

    <div class="mt-7 pt-6 border-t border-dashed border-line-2 flex flex-wrap items-center gap-[14px] reveal">
      <span class="micro whitespace-nowrap">Stack típico:</span>
      <div class="flex flex-wrap gap-[6px]">
        {site.stackChips.map((c) => (
          <span class="font-mono text-[12px] text-ink-2 bg-paper border border-line-2 px-[10px] py-[5px] rounded-full">{c}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .auto-icon {
    width: 38px; height: 38px; border-radius: 8px;
    background: var(--navy); color: var(--terracota);
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 4px;
  }
  .auto-icon svg { display: block; }
</style>
