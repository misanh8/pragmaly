---
import { site } from '../data/site';
---
<section id="nosotros" class="section">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Quiénes somos</span>
      <h2 class="h-section">Dos perfiles, un equipo</h2>
      <p class="lead">Operación e ingeniería en una misma mesa. Eso es lo que hace la diferencia: lo que se rediseña, sale ya con su tablero y su capacitación.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[18px] md:gap-6">
      {site.team.map((p) => (
        <article class="person card-base p-7 reveal">
          <div class={`avatar avatar-${p.avatarStyle}`} aria-hidden="true">{p.monogram}</div>
          <div>
            <h3 class="text-[19px] m-0">{p.name}</h3>
            <div class="role">{p.role}</div>
            <p class="small">{p.bio}</p>
            <div class="tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
            <a href={p.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn de ${p.name}`}>LinkedIn ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .person {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 20px;
    align-items: start;
  }
  .avatar {
    width: 84px; height: 84px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 28px; letter-spacing: -0.02em;
    flex: 0 0 auto; position: relative;
    box-shadow: 0 1px 0 rgba(15, 42, 68, 0.04), 0 1px 2px rgba(15, 42, 68, 0.04);
  }
  .avatar::after {
    content: ""; position: absolute; inset: -4px;
    border: 1px dashed var(--line-2); border-radius: 50%;
  }
  .avatar-navy { background: var(--navy); color: var(--paper); }
  .avatar-terracota { background: var(--terracota); color: var(--ink); }
  .role { color: var(--ink-2); font-size: 14px; margin: 2px 0 10px;
    font-family: var(--mono, "JetBrains Mono"); letter-spacing: 0.02em; }
  .person p { margin: 0 0 14px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .tags span {
    font-family: var(--mono, "JetBrains Mono"); font-size: 10.5px;
    border: 1px solid var(--line-2); padding: 3px 8px; border-radius: 999px; color: var(--ink-2);
  }
  .person a { color: var(--navy); font-weight: 600; font-size: 14px; }
  .person a:hover { color: var(--terracota-2); }
</style>
