---
import { site, waUrl } from '../data/site';
import Logo from './Logo.astro';
---
<header
  id="nav"
  class="sticky top-0 z-40 border-b border-transparent transition-[border-color,background] duration-200"
  style="background: rgba(250, 250, 247, 0.85); backdrop-filter: saturate(160%) blur(10px); -webkit-backdrop-filter: saturate(160%) blur(10px);"
>
  <div class="container-page flex items-center gap-4 h-16">
    <a href="#" class="inline-flex items-center gap-[9px] text-navy font-bold text-[19px] tracking-tight" aria-label={`${site.brand.name} · inicio`}>
      <Logo />
      <span>{site.brand.name}</span>
    </a>
    <nav class="hidden md:inline-flex items-center gap-7 ml-auto mr-3" aria-label="Principal">
      {site.nav.map((item) => (
        <a href={item.href} class="text-ink-2 text-[14.5px] font-medium hover:text-navy transition-colors">{item.label}</a>
      ))}
    </nav>
    <div class="ml-auto md:ml-0">
      <a class="btn btn-primary !py-[9px] !px-[14px] !text-[14px]" href={waUrl()} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20 12a8 8 0 1 1-3.05-6.3L20 4l-1 4.2A8 8 0 0 1 20 12Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
          <path d="M8.5 9.5c0 3.3 2.7 6 6 6l1.5-1.5-2-1-1 .5a4.6 4.6 0 0 1-2.5-2.5l.5-1-1-2L8.5 9.5Z" fill="currentColor" />
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</header>

<style is:global>
  #nav.is-scrolled { border-color: var(--line) !important; background: rgba(250, 250, 247, 0.94) !important; }
</style>
