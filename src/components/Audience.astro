---
import { site } from '../data/site';
---
<section id="publico" class="section">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">A quién servimos</span>
      <h2 class="h-section">¿En cuál te reconoces?</h2>
      <p class="lead">No clasificamos por industria ni tamaño. Trabajamos donde la operación y la tecnología tienen que conversar — sin importar si vendes piezas industriales, atiendes pacientes o sirves tacos.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-[22px]">
      {site.audiences.map((a) => (
        <article class="card-base p-[26px] reveal">
          <div class="aud-tag">{a.tag}</div>
          <h3 class="h-card text-[22px] mt-1">{a.title}</h3>
          <p class="small">{a.desc}</p>
          <div class="flex gap-2 flex-wrap mt-[18px]">
            {a.meta.map((m) => <span class="aud-meta-chip">{m}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .aud-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono, "JetBrains Mono"); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-2); margin-bottom: 16px;
  }
  .aud-tag::before { content: ""; width: 22px; height: 1.5px; background: var(--terracota); }
  .aud-meta-chip {
    font-family: var(--mono, "JetBrains Mono"); font-size: 11.5px; color: var(--ink-2);
    border: 1px solid var(--line-2); padding: 5px 10px; border-radius: 999px;
  }
</style>
